{
  "name": "fbm-pipeline-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3190",
    "contracts:generate": "node scripts/generate-product-workflow-actions.mjs",
    "contracts:check": "node scripts/generate-product-workflow-actions.mjs --check && node --experimental-strip-types scripts/test-product-workflow-actions.mjs && npm run mutations:check",
    "mutations:generate": "node scripts/generate-mutation-inventory.mjs",
    "mutations:check": "node scripts/generate-mutation-inventory.mjs --check && node scripts/test-mutation-inventory.mjs && node --experimental-strip-types scripts/test-mutation-foundation.mjs",
    "test:dev-api-write-guard": "node --experimental-strip-types scripts/test-dev-api-write-guard.mjs",
    "test:workflow-actions:e2e": "playwright test --config=playwright.r1.config.ts",
    "test:product-sections:e2e": "playwright test --config=playwright.product-sections.r1.config.ts",
    "build": "npm run contracts:check && tsc -b && vite build",
    "preview": "vite preview --port 3190"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "antd": "^5.24.0",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0"
  }
}
